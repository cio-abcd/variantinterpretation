/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    cio-abcd/variantinterpretation Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // Requests are capped at params.max_cpus / max_memory / max_time. The cap is
    // written inline because strict syntax does not allow functions (check_max)
    // in config files. Plain values set by a custom config (e.g. withName) are
    // not capped, the same as with the former check_max() function.

    // TODO nf-core: Check the defaults for all processes
    cpus   = { Math.min( 1    * task.attempt, params.max_cpus as int ) }
    memory = { [ 6.GB * task.attempt, params.max_memory as MemoryUnit ].min() }
    time   = { [ 4.h  * task.attempt, params.max_time as Duration ].min() }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { Math.min( 1, params.max_cpus as int ) }
        memory = { [ 6.GB * task.attempt, params.max_memory as MemoryUnit ].min() }
        time   = { [ 4.h  * task.attempt, params.max_time as Duration ].min() }
    }
    withLabel:process_low {
        cpus   = { Math.min( 2     * task.attempt, params.max_cpus as int ) }
        memory = { [ 12.GB * task.attempt, params.max_memory as MemoryUnit ].min() }
        time   = { [ 4.h   * task.attempt, params.max_time as Duration ].min() }
    }
    withLabel:process_medium {
        cpus   = { Math.min( 6     * task.attempt, params.max_cpus as int ) }
        memory = { [ 36.GB * task.attempt, params.max_memory as MemoryUnit ].min() }
        time   = { [ 8.h   * task.attempt, params.max_time as Duration ].min() }
    }
    withLabel:process_high {
        cpus   = { Math.min( 12    * task.attempt, params.max_cpus as int ) }
        memory = { [ 72.GB * task.attempt, params.max_memory as MemoryUnit ].min() }
        time   = { [ 16.h  * task.attempt, params.max_time as Duration ].min() }
    }
    withLabel:process_long {
        time   = { [ 20.h  * task.attempt, params.max_time as Duration ].min() }
    }
    withLabel:process_high_memory {
        memory = { [ 200.GB * task.attempt, params.max_memory as MemoryUnit ].min() }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
