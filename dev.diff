+                input[2] = "${projectDir}/subworkflows/nf-core/utils_nfschema_plugin/tests/nextflow_schema.json"
+                input[3] = false
+                input[4] = false
+                input[5] = false
+                input[6] = ""
+                input[7] = ""
+                input[8] = ""
+                input[9] = null
+                """
